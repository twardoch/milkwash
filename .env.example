# Copy to .env and fill in. Missing providers degrade to "unavailable" — they
# do not block startup. LM Studio ignores the key, so a dummy value is fine.

# LM Studio (default provider; model list comes from the `lms` CLI, not /v1/models)
LMSTUDIO_API_ENDPOINT=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=sk-lm-REPLACE_ME

# Chat2API
CHAT2API_API_ENDPOINT=http://127.0.0.1:8318/v1
CHAT2API_API_KEY=sk-REPLACE_ME

# CLIProxy — if this port is closed, milkwashy retries with (port - 10000),
# e.g. 18317 -> 8317. The check is a real TCP connect, not a guess.
CLIPROXY_API_ENDPOINT=http://0.0.0.0:18317/v1
CLIPROXY_API_KEY=quotio-local-REPLACE_ME
